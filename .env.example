# BPLab Trace LIMS V11 — 环境配置
# 复制此文件为 .env 并填入实际值
# cp .env.example .env

# ── 数据库 (PostgreSQL) ──
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=bplab123
DB_NAME=bplab

# ── 安全 ──
# 生成密钥: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-random-secret-key
JWT_EXPIRE_MINUTES=10080
JWT_REFRESH_DAYS=30

# ── CORS (前端地址，逗号分隔) ──
# 开发: http://localhost:5173
# 生产(单机): http://localhost
# 局域网部署: ["*"] 允许所有来源，或列出具体 IP:
#   ["http://localhost:5173","http://localhost","http://192.168.1.100"]
CORS_ORIGINS=["http://localhost:5173","http://localhost"]

# ── 一体化模式 (生产部署推荐) ──
# true: 后端直接提供前端页面（无需 nginx / node）
# false: 前后端分离（开发模式）
SERVE_FRONTEND=false

# ── 调试模式 ──
DEBUG=false

# ── 上传目录 ──
UPLOAD_DIR=data/uploads
ATTACHMENT_DIR=data/attachments
SIGNATURE_DIR=data/signatures
