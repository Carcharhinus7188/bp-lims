# BPLab Trace — Environment Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ---------- Database ----------
BPLAB_DB_PATH=data/bplab_trace.db
BPLAB_ATTACHMENT_DIR=data/attachments
BPLAB_SIGNATURE_DIR=data/signatures

# ---------- Security ----------
# Generate a strong random key: python -c "import secrets; print(secrets.token_urlsafe(32))"
BPLAB_SECRET_KEY=change-me-to-a-random-secret
BPLAB_SESSION_MAX_AGE_DAYS=7
BPLAB_MAX_LOGIN_ATTEMPTS=5

# ---------- Demo Mode ----------
# Set to "false" in production to skip demo data seeding
BPLAB_DEMO_MODE=true

# Demo users as JSON array of [username, display_name, password, role]
# Remove or set to empty in production
BPLAB_DEMO_USERS=[["admin","系统管理员","admin123","管理员"],["receiver","样品管理员王工","receive123","样品管理员"],["store","样品管理员赵工","store123","样品管理员"],["tester","实验员张工","test123","实验员"],["reviewer","复核员李工","review123","复核员"],["quality","质量负责人周工","quality123","质量负责人"],["approver","管理员刘工","approve123","管理员"]]

# ---------- Company / Branding ----------
BPLAB_COMPANY_CN=大连标普检测有限公司
BPLAB_COMPANY_EN=DALIAN BIAOPU TESTING CO., LTD.
BPLAB_APP_VERSION=BPLab Trace V9.2
BPLAB_TIMEZONE=Asia/Shanghai

# ---------- Logging ----------
BPLAB_LOG_DIR=logs
BPLAB_LOG_LEVEL=INFO
BPLAB_LOG_MAX_BYTES=10485760
BPLAB_LOG_BACKUP_COUNT=5

# ---------- Output ----------
BPLAB_OUTPUT_DIR=data/outputs
