# BPLab Trace — Streamlit Secrets
# Copy this file to .streamlit/secrets.toml and fill in your actual values.
# NEVER commit secrets.toml to version control.
#
# In Streamlit Community Cloud, configure these in the Secrets Manager
# (App settings → Secrets) instead of uploading this file.

# ---------- Security ----------
BPLAB_SECRET_KEY = "change-me-to-a-random-secret"

# ---------- Demo Mode ----------
# Set to "false" in production
BPLAB_DEMO_MODE = "true"

# ---------- Company / Branding ----------
BPLAB_COMPANY_CN = "大连标普检测有限公司"
BPLAB_COMPANY_EN = "DALIAN BIAOPU TESTING CO., LTD."
